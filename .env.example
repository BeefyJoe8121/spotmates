# `eas integrations:supabase:connect` writes these for you (to .env.local and to your Expo project).
# To fill them by hand instead: Supabase → Project Settings → API keys.
# Both are designed to ship inside the app; never put a secret/service_role key here.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
